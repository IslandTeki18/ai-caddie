{
  "expo": {
    "name": "ai-caddie",
    "slug": "ai-caddie",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ai-caddie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.landon-m.aicaddie"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.landon_m.aicaddie"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
